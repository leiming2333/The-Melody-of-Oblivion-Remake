# Reference only. Set these in Vercel; do not publish a real .env file.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DOWNLOAD_ALLOWED_HOSTNAMES=www.melodyoblivion.xyz,melodyoblivion.xyz
# The API and browser both pin this production hostname. Do not substitute a
# workers.dev URL or another hostname; that disables verified downloads.
DOWNLOAD_CDN_BASE_URL=https://downloads.melodyoblivion.xyz
DOWNLOAD_URL_TTL_SECONDS=900

# Generate a random secret (at least 32 UTF-8 bytes). Set the EXACT same value
# in Vercel and as a Cloudflare Worker Secret named DOWNLOAD_AUTH_SECRET.
# Never put the real value in wrangler.jsonc vars, frontend code, or Git.
DOWNLOAD_AUTH_SECRET=
