{
  "name": "melody-of-oblivion-launcher",
  "version": "1.7.0",
  "description": "我的世界忘却的旋律启动器",
  "author": {
    "name": "leiming2333",
    "email": "leiming2333@users.noreply.github.com"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "node scripts/build.cjs",
    "build:win": "node scripts/build.cjs --win",
    "build:linux": "node scripts/build.cjs --linux",
    "build:mac": "node scripts/build.cjs --mac",
    "build:targets": "node scripts/release-targets.cjs",
    "verify:toolchain": "node scripts/toolchain.cjs",
    "smoke": "electron . --smoke-test",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "24.x || 26.10.0",
    "npm": "11.13.0"
  },
  "build": {
    "appId": "com.melodyofoblivion.launcher",
    "productName": "Melody of Oblivion Launcher",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "leiming2333",
      "repo": "The-Melody-of-Oblivion-Remake"
    },
    "files": [
      "src/**/*",
      "package.json",
      "src/main/accounts/microsoft-client-id.json"
    ],
    "win": {
      "icon": "src/renderer/assets/app-icon.ico",
      "artifactName": "The-Melody-of-Oblivion-Remake-Windows-${arch}.${ext}",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "The-Melody-of-Oblivion-Remake-Windows-${arch}.${ext}",
      "useZip": false
    },
    "linux": {
      "icon": "src/renderer/assets/app-icon.png",
      "artifactName": "The-Melody-of-Oblivion-Remake-Linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "src/renderer/assets/app-icon.icns",
      "artifactName": "The-Melody-of-Oblivion-Remake-macOS-${arch}.${ext}",
      "target": [
        "zip"
      ]
    },
    "afterPack": "scripts/portable-build-hook.js"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1"
  }
}
